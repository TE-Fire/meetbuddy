# 后端本地启动凭据模板 —— 首次使用先复制：
#   cp server/.env.local.example server/.env.local
# .env.local 已被 gitignore，仓库里只有这份模板，真实口令不入库。
#
# 变量名必须和 application.yml 里引用的占位符逐字一致（含大小写），
# 拼错会直接抛 "Could not resolve placeholder"，不给出默认值就是要它响亮地失败。

# ── MySQL ──────────────────────────────────────
# 本机 8.0.43 的 root 口令
MYSQL_PASSWORD=change-me

# ── Redis ──────────────────────────────────────
# 须与 server/docker/.env 里的 REDIS_PASSWORD 取同一个值，否则应用连不上容器
MEETBUDDY_REDIS_PASSWORD=change-me

# 宿主端口，默认 6380（本机 6379 被旧版 Redis 3.0 占着）
MEETBUDDY_REDIS_PORT=6380
