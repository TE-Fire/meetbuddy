.dock {
  position: fixed;
  left: 36rpx;
  right: 36rpx;
  bottom: 28rpx;
  height: 124rpx;
  border-radius: 999rpx;
  background: rgba(23, 26, 29, 0.94);
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-shadow: 0 24rpx 56rpx rgba(23, 26, 29, 0.35);
  z-index: 100;
}
.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 0;
  border-radius: 999rpx;
}
.item.on {
  background: rgba(255, 255, 255, 0.10);
}
.icon-wrap {
  position: relative;
  line-height: 1;
}
.icon {
  font-size: 40rpx;
  filter: grayscale(1) brightness(1.6);
  opacity: 0.75;
}
.item.on .icon {
  filter: none;
  opacity: 1;
}
.item.on .label {
  color: #fff;
  font-weight: 800;
}
.label {
  font-size: 20rpx;
  font-weight: 600;
  color: #939ba3;
}
.badge {
  position: absolute;
  right: -16rpx;
  top: -8rpx;
  min-width: 30rpx;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  background: var(--hot);
  border: 3rpx solid var(--black);
  color: #fff;
  font-size: 18rpx;
  font-weight: 800;
  text-align: center;
  box-sizing: border-box;
}
