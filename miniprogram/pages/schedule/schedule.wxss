.page {
  padding: 24rpx 32rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* —— 顶部筛选 —— */
.seg {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.seg-i {
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 3rpx solid var(--line);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
}
.seg-i.on {
  background: var(--brand);
  border-color: var(--brand);
  color: #fff;
  font-weight: 800;
  box-shadow: var(--shadow-glow);
}

/* —— 日期分组 —— */
.g {
  margin-bottom: 36rpx;
}
.g.past {
  opacity: 0.6;
}
.g-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 8rpx 0 16rpx;
}
.g-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--brand);
}
.g-label {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
}
.g-tag {
  font-size: 20rpx;
  color: #939BA3;
  background: #eef1f4;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}

/* —— 事件卡片（时间轴节点） —— */
.ev {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border: 3rpx solid var(--line);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
}
.ev.past {
  opacity: 0.55;
}
.ev-time {
  width: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}
.ev-hm {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}
.ev-role {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #939BA3;
  background: #f1f3f5;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}
.ev-role.host {
  color: #fff;
  background: var(--brand);
}
.ev-main {
  flex: 1;
  min-width: 0;
}
.ev-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}
.ev-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #939BA3;
}
.ev-go {
  color: #c4cad1;
  font-size: 36rpx;
  flex-shrink: 0;
}

/* —— 空态 / 加载 —— */
.loading,
.empty {
  text-align: center;
  padding: 140rpx 0;
  color: #939BA3;
}
.e-icon {
  font-size: 80rpx;
}
.e-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  margin-top: 16rpx;
}
.e-hint {
  font-size: 24rpx;
  margin-top: 8rpx;
}
