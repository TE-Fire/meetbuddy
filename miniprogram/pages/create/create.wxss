.page {
  padding: 28rpx 36rpx 80rpx;
}
.box {
  margin-top: 32rpx;
  padding: 36rpx;
}
.label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 29rpx;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 24rpx;
}
.label::before {
  content: '';
  width: 16rpx;
  height: 16rpx;
  border-radius: 6rpx;
  background: var(--brand);
}
.counter {
  text-align: right;
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 12rpx;
}

.chips-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.time-row {
  display: flex;
  gap: 20rpx;
}
.time-box {
  flex: 1;
  background: var(--field-bg);
  border: 3rpx solid var(--line);
  border-radius: 28rpx;
  padding: 22rpx 26rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.tl {
  font-size: 22rpx;
  color: var(--muted);
}
.tv {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--ink);
}
.tv.dim {
  color: var(--muted);
  font-weight: 500;
}

.picker {
  background: var(--field-bg);
  border: 3rpx solid var(--line);
  border-radius: 28rpx;
  padding: 28rpx;
  font-size: 28rpx;
  color: var(--ink);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.caret {
  color: var(--muted);
}
.mt {
  margin-top: 22rpx;
}

.srow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}
.slabel {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--ink-2);
}
.stepper {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.step {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 900;
  color: var(--brand-deep);
}
.snum {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--brand-deep);
  min-width: 50rpx;
  text-align: center;
}

.field.area {
  height: 220rpx;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}
.field.area textarea {
  height: 100%;
}

.tip {
  margin-top: 30rpx;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 25rpx;
  line-height: 1.5;
}
