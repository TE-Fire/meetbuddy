.page {
  padding: 24rpx 40rpx 60rpx;
}
.head {
  padding: 10rpx 6rpx 30rpx;
}
.head .display {
  font-size: 44rpx;
}
.display-sub {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--muted);
}

/* 预览框：尺寸由 poster.js 按屏宽算好后以内联 style 给出（width/height）。
   圆角与阴影只是相框观感；canvas 的 CSS 盒子与 stage 等大，不依赖父级裁切。 */
.stage {
  margin: 0 auto;
  border-radius: 28rpx;
  box-shadow: var(--shadow-card);
  background: #fff;
}
/* 显示尺寸由内联 style 给（= stage 尺寸）；这里只做块级化。
   位图尺寸（750×1240 × dpr）在 poster.js 里设 canvas.width/height，是本页导出的取景基准。 */
.canvas {
  display: block;
  border-radius: 28rpx;
}

.hint {
  margin: 28rpx 0 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
}
.actions {
  margin-top: 40rpx;
}
.retry {
  margin-top: 30rpx;
  height: 88rpx;
  font-size: 28rpx;
}
