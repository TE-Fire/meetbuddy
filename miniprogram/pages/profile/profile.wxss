.page {
  padding: 30rpx 40rpx 220rpx;
  text-align: center;
}
.logout {
  position: absolute;
  right: 40rpx;
  top: 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  font-size: 23rpx;
  font-weight: 700;
  color: var(--muted);
}
.avatar {
  width: 172rpx;
  height: 172rpx;
  margin: 20rpx auto 0;
  border-radius: 60rpx;
  background: linear-gradient(160deg, #ffb36b, #ff7a9e);
  border: 8rpx solid #fff;
  box-shadow: 0 24rpx 56rpx rgba(255, 122, 158, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  color: #fff;
  font-weight: 900;
}
.nameline {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.name {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--ink);
}
.lv {
  background: var(--brand-soft);
  color: var(--brand-deep);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  font-weight: 800;
}
.bio {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--muted);
}

.stats {
  margin-top: 36rpx;
  display: flex;
  padding: 32rpx 0;
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.stat + .stat {
  border-left: 1rpx solid var(--line);
}
.stat .v {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--ink);
}
.stat .l {
  font-size: 23rpx;
  color: var(--muted);
}

.src {
  display: inline-block;
  margin-top: 26rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  color: var(--muted);
}

.section-title {
  margin: 52rpx 0 24rpx;
  text-align: left;
}
.none {
  text-align: left;
  font-size: 25rpx;
  color: var(--muted);
  margin-bottom: 10rpx;
}
.cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  text-align: left;
}
.mini {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 30rpx;
}
.micon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 30rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  flex-shrink: 0;
}
.mbody {
  flex: 1;
  min-width: 0;
}
.mtitle {
  font-size: 29rpx;
  font-weight: 800;
  color: var(--ink);
}
.mmeta {
  margin: 10rpx 0 16rpx;
  font-size: 23rpx;
  color: var(--muted);
}
