.page {
  padding: 30rpx 40rpx 220rpx;
  text-align: center;
}
.avatar {
  position: relative;
  width: 172rpx;
  height: 172rpx;
  margin: 20rpx auto 0;
  border-radius: 60rpx;
  background: linear-gradient(160deg, #ffb36b, #ff7a9e);
  border: 8rpx solid #fff;
  box-shadow: 0 24rpx 56rpx rgba(255, 122, 158, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  color: #fff;
  font-weight: 900;
}
.nameline {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.name {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--ink);
}
.lv {
  background: var(--brand-soft);
  color: var(--brand-deep);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  font-weight: 800;
}
.bio {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--muted);
}
/* 简介行内的编辑入口：低调的浅色小字，不抢签名本身的注意力 */
.bio-edit {
  margin-left: 14rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--brand);
}
/* 头像右下角的编辑角标，提示整颗头像是可点的 */
.avatar-badge {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 158, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}
/* 有头像时：背景铺图、文字透明，首字母退场 */
.avatar.has-img {
  background-size: cover;
  background-position: center;
  color: transparent;
}
/* 编辑面板里的头像选择器 */
.avatar-pick {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin: 18rpx 0 6rpx;
}
.ap-img {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #ffb36b, #ff7a9e);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  color: #fff;
  font-weight: 900;
  border: 4rpx solid #fff;
  box-shadow: 0 12rpx 28rpx rgba(255, 122, 158, 0.35);
  background-size: cover;
  background-position: center;
  overflow: hidden;
}
.ap-img.has {
  color: transparent;
}
.ap-tip {
  font-size: 23rpx;
  color: var(--muted);
}

.stats {
  margin-top: 36rpx;
  display: flex;
  padding: 32rpx 0;
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.stat + .stat {
  border-left: 1rpx solid var(--line);
}
.stat .v {
  font-size: 38rpx;
  font-weight: 900;
  color: var(--ink);
}
.stat .l {
  font-size: 22rpx;
  color: var(--muted);
}

/* 高频入口 4 宫格：替代原来 8 行大菜单卡，两列紧凑排布 */
.grid {
  margin-top: 28rpx;
  padding: 20rpx 16rpx;
  display: flex;
  flex-wrap: wrap;
}
.gitem {
  width: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 0;
}
.gic {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.gtx {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--ink);
}

/* 低频操作：一行小字，不占菜单位 */
.lite-row {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}
.lite {
  font-size: 23rpx;
  color: var(--muted);
}
.lite.warn {
  color: #e0666f;
}
.lite-sep {
  color: var(--line);
}

/* 数据条可点：数字即入口，按下有轻微反馈 */
.stat.tap {
  cursor: pointer;
}
.stat.tap:active {
  opacity: 0.6;
}

.section-title {
  margin: 52rpx 0 24rpx;
  text-align: left;
}
.none {
  text-align: left;
  font-size: 25rpx;
  color: var(--muted);
  margin-bottom: 10rpx;
}
.cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  text-align: left;
}
.mini {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 30rpx;
}
.micon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 30rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  flex-shrink: 0;
}
.mbody {
  flex: 1;
  min-width: 0;
}
.mtitle {
  font-size: 29rpx;
  font-weight: 800;
  color: var(--ink);
}
.mmeta {
  margin: 10rpx 0 16rpx;
  font-size: 23rpx;
  color: var(--muted);
}

/* ============ 编辑资料面板（与 create 页时间面板同款结构，页面级样式各自持有） ============ */
/* z-index 必须高于自定义菜单栏 .dock 的 100：profile 是 tab 页，菜单栏常驻悬浮，
   面板盖不住它的话，底部「取消/保存」会被挡死点不到。非 tab 页（create/buddy 等）
   没有菜单栏，用原来的 50/51 也不会穿帮，但统一抬到 200/201 更好记。 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(23, 26, 29, 0.45);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.28s;
  z-index: 200;
}
.mask.show {
  opacity: 1;
  visibility: visible;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 201;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 22rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  box-shadow: var(--shadow-ink);
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  /* 固定高度 + 纵向 flex：head/actions 定住，中间 sheet-body 独立滚动 */
  height: 82vh;
  display: flex;
  flex-direction: column;
}
.sheet.show {
  transform: translateY(0);
}
/* 弹层内滚动区：加标签建议池后内容超一屏，必须可滚 */
.sheet-body {
  flex: 1;
  min-height: 0;
  margin: 0 -36rpx;
  padding: 0 36rpx;
  box-sizing: border-box;
}
.sheet-grip {
  width: 72rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--line);
  margin: 4rpx auto 16rpx;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sheet-title {
  font-size: 33rpx;
  font-weight: 900;
  color: var(--ink);
}
.sheet-x {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--field-bg);
  color: var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}
.label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 29rpx;
  font-weight: 800;
  color: var(--ink);
  margin: 26rpx 0 18rpx;
}
.label::before {
  content: '';
  width: 16rpx;
  height: 16rpx;
  border-radius: 6rpx;
  background: var(--brand);
}
.field.area {
  height: 220rpx;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}
.field.area textarea {
  height: 100%;
}
.picker {
  background: var(--field-bg);
  border: 3rpx solid var(--line);
  border-radius: 28rpx;
  padding: 28rpx;
  font-size: 28rpx;
  color: var(--ink);
}
.caret {
  color: var(--muted);
}
.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}
.sheet-actions .btn-ghost,
.sheet-actions .btn-black {
  flex: 1;
}

/* ============ 兴趣标签（展示卡 / 引导卡） ============ */
.tags-card {
  margin-top: 28rpx;
  padding: 30rpx 32rpx;
  text-align: left;
}
.tags-title {
  font-size: 27rpx;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 18rpx;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
/* 引导卡：无标签时的轻提示，整卡可点进编辑；不用弹窗，不打断浏览 */
.tags-guide {
  margin-top: 28rpx;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  text-align: left;
}
.tg-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
.tg-tx {
  flex: 1;
  min-width: 0;
}
.tg-t {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
}
.tg-s {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--muted);
}
.tg-go {
  flex-shrink: 0;
  font-size: 25rpx;
  font-weight: 800;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
}

/* ============ 编辑面板里的兴趣标签 ============ */
.tags-hint {
  font-size: 23rpx;
  color: var(--muted);
  margin-bottom: 18rpx;
  line-height: 1.5;
}
/* 已选标签：可点删，x 角标提示可移除 */
.tag-pick {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 16rpx;
}
.tp {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: var(--shadow-glow);
}
.tp-x {
  font-size: 20rpx;
  opacity: 0.85;
}
/* 建议池：未选为描边，选中高亮 */
.tag-suggest {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.ts {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 3rpx solid var(--line);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
}
.ts.on {
  background: var(--brand-soft);
  border-color: var(--brand);
  color: var(--brand-deep);
  font-weight: 800;
}
/* 自定义补充：输入框 + 添加按钮一行 */
.tag-add {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}
.ta-in {
  flex: 1;
  background: var(--field-bg);
  border: 3rpx solid var(--line);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--ink);
}
.ta-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  border-radius: 24rpx;
  background: var(--brand);
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
}
.tag-count {
  margin-top: 12rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--muted);
}
