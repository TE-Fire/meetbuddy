<view class="sky page">
  <view class="conn {{connected ? 'on' : ''}}">
    <view class="dot"></view>
    <text>{{connected ? '实时在线' : '连接中…'}}</text>
  </view>

  <!-- 通知入口：未读数来自 /api/notification/unread，与 tab 徽标同源 -->
  <view class="notify-entry card-sm" bindtap="openNotifications">
    <view class="ne-icon">🔔</view>
    <view class="ne-body">
      <view class="ne-title">通知</view>
      <view class="ne-hint">报名提醒 · 活动取消 · 开始前提醒</view>
    </view>
    <view wx:if="{{notifUnread > 0}}" class="ne-badge">{{notifUnread > 99 ? '99+' : notifUnread}}</view>
    <text wx:else class="ne-arrow">›</text>
  </view>

  <block wx:if="{{groups.length || sessions.length}}">
    <block wx:if="{{groups.length}}">
      <view class="sec-title">群聊</view>
      <view
        wx:for="{{groups}}"
        wx:key="id"
        class="group card-sm"
        data-g="{{item}}"
        bindtap="openRoom"
      >
        <view class="gava">💬</view>
        <view class="gbody">
          <view class="grow ellipsis gname">{{item.name}}</view>
          <view class="glast ellipsis">{{item.lastMessage || '还没有消息'}}</view>
        </view>
        <view class="gright">
          <text class="gtime">{{item.agoText}}</text>
          <view wx:if="{{item.unread > 0}}" class="gunread">{{item.unread > 99 ? '99+' : item.unread}}</view>
          <text wx:else class="gcount">{{item.memberCount}} 人</text>
        </view>
      </view>
    </block>

    <block wx:if="{{sessions.length}}">
      <view class="sec-title">私聊</view>
      <view
        wx:for="{{sessions}}"
        wx:key="peerId"
        class="group card-sm"
        data-s="{{item}}"
        bindtap="openSession"
      >
        <view class="sava {{item.avatarUrl ? 'has-img' : ''}}" catchtap="openPeerProfile" data-id="{{item.peerId}}" style="background-image: url('{{item.avatarUrl}}')">{{!item.avatarUrl ? item.first : ''}}</view>
        <view class="gbody">
          <view class="grow ellipsis gname">{{item.peerNickname}}</view>
          <view class="glast ellipsis">{{item.lastText}}</view>
        </view>
        <view class="gright">
          <text class="gtime">{{item.agoText}}</text>
          <view wx:if="{{item.unread > 0}}" class="gunread">{{item.unread > 99 ? '99+' : item.unread}}</view>
        </view>
      </view>
    </block>
  </block>

  <view wx:elif="{{!loading}}" class="empty card">
    <view class="icon">💬</view>
    <view class="title">还没有会话</view>
    <view class="hint">报名活动会自动进群；在「找搭子」里点「私聊 TA」即可开一个私聊</view>
  </view>

  <view wx:else class="loading">加载中…</view>
</view>
