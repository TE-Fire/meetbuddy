<view class="sky page" wx:if="{{u}}">
  <!-- 头部：头像 + 昵称 + 信用分 / 封禁态 + 关注按钮 -->
  <view class="head card">
    <view class="avatar {{u.avatar ? 'has-img' : ''}}" style="background-image: url('{{u.avatarUrl}}')">{{!u.avatar ? u.first : ''}}</view>
    <view class="hinfo">
      <view class="hname ellipsis">{{u.nickname}}</view>
      <view class="htags">
        <view class="tag">信用分 {{u.creditScore}}</view>
        <view wx:if="{{u.self}}" class="tag grass">这是你</view>
        <view wx:elif="{{u.banned}}" class="tag warm">已封禁</view>
      </view>
    </view>
    <view wx:if="{{!u.self}}" class="follow-btn {{u.following ? 'on' : ''}}" catchtap="toggleFollow">
      {{u.following ? '已关注' : '+ 关注'}}
    </view>
  </view>

  <!-- 关注 / 粉丝：数字可点，进列表 -->
  <view class="follow-stats card-sm">
    <view class="fs" data-tab="following" bindtap="openFollowList">
      <text class="fsv">{{u.followingCount}}</text><text class="fsl">关注</text>
    </view>
    <view class="fdiv"></view>
    <view class="fs" data-tab="followers" bindtap="openFollowList">
      <text class="fsv">{{u.followerCount}}</text><text class="fsl">粉丝</text>
    </view>
    <view class="fdiv"></view>
    <view class="fs static">
      <text class="fsv">{{u.creditScore}}</text><text class="fsl">信用分</text>
    </view>
  </view>

  <view wx:if="{{u.bio}}" class="bio card-sm">{{u.bio}}</view>

  <view wx:if="{{u.tags.length}}" class="card-sm tags-card">
    <view class="tags-title">兴趣标签</view>
    <view class="tags">
      <view wx:for="{{u.tags}}" wx:key="*this" class="tag plain">{{item}}</view>
    </view>
  </view>

  <view class="card stats">
    <view class="stat"><text class="v">{{u.hostedCount}}</text><text class="l">完成组局</text></view>
    <view class="stat"><text class="v">{{u.joinedCount}}</text><text class="l">完成参与</text></view>
    <view class="stat"><text class="v">{{u.badges.length}}</text><text class="l">勋章</text></view>
  </view>

  <!-- 勋章墙：只展示已得的，置灰与进度在"我的勋章"页 -->
  <view class="section-title">勋章墙</view>
  <view wx:if="{{!u.badges.length}}" class="none">还没有获得勋章</view>
  <view wx:else class="badges">
    <view wx:for="{{u.badges}}" wx:key="code" class="bchip card-sm">
      <text class="bi">{{item.icon}}</text>
      <text class="bn">{{item.name}}</text>
    </view>
  </view>

  <!-- 最近完成的活动：组织与参加合并 -->
  <view class="section-title">最近完成</view>
  <view wx:if="{{!u.recent.length}}" class="none">还没有完成的活动</view>
  <view wx:else class="cards">
    <view wx:for="{{u.recent}}" wx:key="id" class="mini card" data-id="{{item.id}}" bindtap="openDetail">
      <view class="micon {{item.cover ? 'has' : ''}}" style="background-image: url('{{item.cover}}')">{{item.cover ? '' : '✨'}}</view>
      <view class="mbody">
        <view class="mtitle ellipsis">{{item.title}}</view>
        <view class="mmeta">{{item.roleText}} · {{item.timeText}} · {{item.statusText}}</view>
      </view>
    </view>
  </view>
</view>

<view class="sky page" wx:elif="{{!loading}}">
  <view class="empty card">
    <view class="icon">🫥</view>
    <view class="title">用户不存在</view>
    <view class="hint">可能已被注销，返回上一页吧</view>
  </view>
</view>
