.head {
  margin: 24rpx 32rpx 0;
  padding: 40rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
}
.avatar {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand), #6fd0ff);
  color: #fff;
  font-size: 56rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-glow);
}
.hinfo {
  flex: 1;
  min-width: 0;
}
.hname {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--ink);
}
.htags {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
}

/* 关注按钮：未关注为黑底实心，已关注为浅底描边 */
.follow-btn {
  flex-shrink: 0;
  align-self: center;
  padding: 18rpx 34rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 800;
  background: var(--ink);
  color: #fff;
}
.follow-btn.on {
  background: var(--field-bg);
  color: var(--muted);
  border: 3rpx solid var(--line);
}

/* 关注 / 粉丝统计条 */
.follow-stats {
  margin: 20rpx 32rpx 0;
  padding: 26rpx 0;
  display: flex;
  align-items: center;
}
.follow-stats .fs {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.follow-stats .fsv {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--ink);
}
.follow-stats .fsl {
  font-size: 24rpx;
  color: var(--muted);
}
.follow-stats .fdiv {
  width: 2rpx;
  height: 48rpx;
  background: var(--line);
}

.bio {
  margin: 24rpx 32rpx 0;
  padding: 28rpx 32rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.6;
}
.tags-card {
  margin: 20rpx 32rpx 0;
}
.tags-title {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 16rpx;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.stats {
  margin: 24rpx 32rpx 0;
  padding: 32rpx 0;
  display: flex;
}
.stat {
  flex: 1;
  text-align: center;
}
.stat .v {
  display: block;
  font-size: 44rpx;
  font-weight: 900;
  color: var(--ink);
}
.stat .l {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.section-title {
  margin: 48rpx 32rpx 24rpx;
}

.none {
  margin: 0 32rpx;
  padding: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--muted);
  background: #fff;
  border-radius: 32rpx;
}

.badges {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 32rpx;
}
.bchip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 26rpx;
  background: linear-gradient(180deg, #ffffff 0%, var(--grass-soft) 100%);
}
.bchip .bi {
  font-size: 40rpx;
}
.bchip .bn {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--grass-ink);
}

.cards {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.mini {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 28rpx;
}
.micon {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}
.micon.has {
  background-size: cover;
  background-position: center;
}
.mbody {
  flex: 1;
  min-width: 0;
}
.mtitle {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--ink);
}
.mmeta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--muted);
}
