/* ============ 页签 ============ */
.tabs {
  display: flex;
  margin-top: 24rpx;
  padding: 10rpx;
  border-radius: 999rpx;
}
.tab {
  flex: 1;
  height: 72rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--muted);
  transition: all 0.25s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.tab.on {
  background: var(--brand);
  color: #fff;
  box-shadow: var(--shadow-glow);
}

/* ============ 坐标条（与 feed 一致） ============ */
.geo-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding: 18rpx 28rpx;
  font-size: 24rpx;
  color: var(--muted);
}
.geo-bar .change {
  color: var(--brand);
  font-weight: 800;
}

/* ============ 匹配卡片 ============ */
.mcard {
  margin-top: 24rpx;
  padding: 30rpx 36rpx;
}
.mhead {
  display: flex;
  align-items: center;
  gap: 22rpx;
}
.mavatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand), #6fd0ff);
  color: #fff;
  font-size: 36rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.minfo {
  flex: 1;
  min-width: 0;
}
.mname {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--ink);
}
.mmeta {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--muted);
}
.mscore {
  text-align: center;
  flex-shrink: 0;
}
.msc-num {
  display: block;
  font-size: 38rpx;
  font-weight: 900;
  color: var(--brand);
  line-height: 1;
}
.msc-lbl {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
}
.mtitle {
  margin-top: 22rpx;
  font-size: 29rpx;
  font-weight: 800;
  color: var(--ink);
}
.mtags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}
.mtag {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  background: var(--field-bg);
  color: var(--muted);
}
.mtag.grass {
  background: var(--grass-soft);
  color: var(--grass-ink);
}
.mtag.brand {
  background: var(--brand-soft);
  color: var(--brand-deep);
}
.mreason {
  margin-top: 18rpx;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  background: var(--field-bg);
  font-size: 24rpx;
  color: var(--ink);
  line-height: 1.6;
}
.mactions {
  margin-top: 22rpx;
}

/* ============ 我的需求卡片 ============ */
.bcard {
  margin-top: 24rpx;
  padding: 30rpx 36rpx;
}
.bhead {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.btitle {
  flex: 1;
  font-size: 30rpx;
  font-weight: 900;
  color: var(--ink);
}
.bstatus {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
}
.bstatus.open {
  background: var(--grass-soft);
  color: var(--grass-ink);
}
.bstatus.closed {
  background: var(--field-bg);
  color: var(--muted);
}
.bdesc {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: var(--muted);
  line-height: 1.6;
}
.bfoot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 22rpx;
}
.btime {
  font-size: 22rpx;
  color: var(--muted);
}
.bclose {
  font-size: 25rpx;
  font-weight: 800;
  color: #eb4d5c;
  padding: 10rpx 20rpx;
}

/* ============ 表单（label / field / chips，与 create 页同款） ============ */
.label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 29rpx;
  font-weight: 800;
  color: var(--ink);
  margin: 26rpx 0 18rpx;
}
.label::before {
  content: '';
  width: 16rpx;
  height: 16rpx;
  border-radius: 6rpx;
  background: var(--brand);
}
.chips-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}
.field.area {
  height: 200rpx;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}
.field.area textarea {
  height: 100%;
}

/* ============ 发布面板（与 create 页时间面板同款） ============ */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(23, 26, 29, 0.45);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.28s;
  z-index: 50;
}
.mask.show {
  opacity: 1;
  visibility: visible;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 51;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 22rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  box-shadow: var(--shadow-ink);
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  max-height: 82vh;
  overflow-y: auto;
}
.sheet.show {
  transform: translateY(0);
}
.sheet-grip {
  width: 72rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--line);
  margin: 4rpx auto 16rpx;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sheet-title {
  font-size: 33rpx;
  font-weight: 900;
  color: var(--ink);
}
.sheet-x {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--field-bg);
  color: var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}
.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}
.sheet-actions .btn-ghost,
.sheet-actions .btn-black {
  flex: 1;
}
