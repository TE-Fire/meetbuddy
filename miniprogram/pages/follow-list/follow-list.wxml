<view class="sky page">
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="k"
      class="tab {{tab === item.k ? 'on' : ''}}"
      data-k="{{item.k}}"
      bindtap="switchTab"
    >{{item.l}}</view>
  </view>

  <view wx:if="{{!list.length && !loading}}" class="empty card">
    <view class="icon">🫂</view>
    <view class="title">{{tab === 'following' ? '还没有关注任何人' : '还没有粉丝'}}</view>
    <view class="hint">{{tab === 'following' ? '去活动里认识几个搭子吧' : '多发起活动，会有人来关注你'}}</view>
  </view>

  <view class="rows">
    <view
      wx:for="{{list}}"
      wx:key="userId"
      class="row card-sm"
      data-id="{{item.userId}}"
      bindtap="openUser"
    >
      <view class="avatar {{item.avatar ? 'has-img' : ''}}" style="background-image: url('{{item.avatarUrl}}')">{{!item.avatar ? item.first : ''}}</view>
      <view class="rinfo">
        <view class="rname ellipsis">{{item.nickname}}</view>
        <view class="rmeta">信用分 {{item.creditScore}}{{item.banned ? ' · 已封禁' : ''}}</view>
      </view>
      <view class="marr">›</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="foot">加载中…</view>
  <view wx:elif="{{finished && list.length}}" class="foot">没有更多了</view>
</view>
