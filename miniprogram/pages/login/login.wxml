<view class="sky login">
  <view class="display" style="text-align:center;">告别一个人<text class="hl">组局出发</text></view>
  <view class="display-sub" style="text-align:center;">同城组局，找个搭子</view>

  <map-scene
    class="hero"
    badge="📍 周六 19:00 · 4 人成局"
    sticker="🎲"
    sticker2="🏸"
    pins="{{[{text:'飞盘局', x:0.5, y:0.2},{text:'桌游 4 缺 2', x:0.1, y:0.52, accent:true}]}}"
  />

  <!-- 模式切换 -->
  <view class="switch card-sm">
    <view class="seg {{mode === 'password' ? 'on' : ''}}" data-mode="password" bindtap="switchMode">密码登录</view>
    <view class="seg {{mode === 'sms' ? 'on' : ''}}" data-mode="sms" bindtap="switchMode">验证码</view>
    <view class="seg {{mode === 'register' ? 'on' : ''}}" data-mode="register" bindtap="switchMode">注册</view>
  </view>

  <view class="form">
    <view class="field"><input type="number" maxlength="11" placeholder="手机号" value="{{phone}}" bindinput="onPhone" /></view>
    <view class="field" wx:if="{{mode === 'register'}}"><input placeholder="昵称" value="{{nickname}}" bindinput="onNickname" /></view>
    <view class="field" wx:if="{{mode !== 'sms'}}"><input password placeholder="密码" value="{{password}}" bindinput="onPassword" /></view>
    <view class="code-row" wx:if="{{mode !== 'password'}}">
      <view class="field grow"><input type="number" maxlength="6" placeholder="验证码" value="{{code}}" bindinput="onCode" /></view>
      <view class="btn-ghost send {{countdown > 0 ? 'disabled' : ''}}" bindtap="sendCode">
        {{countdown > 0 ? countdown + 's' : '获取验证码'}}
      </view>
    </view>

    <view wx:if="{{error}}" class="error">{{error}}</view>

    <view class="btn-black {{busy ? 'disabled' : ''}}" bindtap="submit">
      {{busy ? '登录中…' : (mode === 'register' ? '注册并登录' : '登录')}}
    </view>
    <view class="agree">登录即代表同意 用户协议 与 隐私政策</view>
  </view>
</view>
