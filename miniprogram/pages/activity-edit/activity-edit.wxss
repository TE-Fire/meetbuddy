.page {
  padding: 28rpx 36rpx 80rpx;
}
.display {
  font-size: 44rpx;
  font-weight: 900;
  color: var(--ink);
  margin-top: 8rpx;
}
.display .hl {
  color: var(--brand-deep);
}
.display-sub {
  font-size: 25rpx;
  color: var(--muted);
  margin-top: 10rpx;
  line-height: 1.5;
}
.box {
  margin-top: 32rpx;
  padding: 36rpx;
}
.label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 29rpx;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 24rpx;
}
.label::before {
  content: '';
  width: 16rpx;
  height: 16rpx;
  border-radius: 6rpx;
  background: var(--brand);
}
.label-tip {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--muted);
  margin-left: auto;
}
.counter {
  text-align: right;
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 12rpx;
}
.field {
  background: var(--field-bg);
  border: 3rpx solid var(--line);
  border-radius: 28rpx;
  padding: 28rpx;
  font-size: 28rpx;
  color: var(--ink);
}
.hint {
  font-size: 22rpx;
  color: var(--brand-deep);
  margin-top: 16rpx;
}

.chips-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

/* —— 时间卡：点按打开滑动面板 —— */
.time-card {
  cursor: pointer;
}
.time-empty {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--muted);
  background: var(--field-bg);
  border: 3rpx dashed var(--line);
  border-radius: 28rpx;
  padding: 28rpx;
}
.time-row2 {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}
.tcol {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}
.tcol.dur {
  flex: 0 0 auto;
  align-items: flex-end;
}
.tl {
  font-size: 22rpx;
  color: var(--muted);
}
.tv {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}
.tcol.dur .tv {
  color: var(--brand-deep);
}

.picker {
  background: var(--field-bg);
  border: 3rpx solid var(--line);
  border-radius: 28rpx;
  padding: 28rpx;
  font-size: 28rpx;
  color: var(--ink);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.caret {
  color: var(--muted);
}
.mt {
  margin-top: 22rpx;
}

.srow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}
.slabel {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--ink-2);
}
.stepper {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.step {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 900;
  color: var(--brand-deep);
}
.snum {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--brand-deep);
  min-width: 50rpx;
  text-align: center;
}

.field.area {
  height: 220rpx;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}
.field.area textarea {
  height: 100%;
}

.tip {
  margin-top: 30rpx;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 25rpx;
  line-height: 1.5;
}

/* ============ 时间滑动面板 ============ */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(23, 26, 29, 0.45);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.28s;
  z-index: 50;
}
.mask.show {
  opacity: 1;
  visibility: visible;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 51;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 22rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  box-shadow: var(--shadow-ink);
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.sheet.show {
  transform: translateY(0);
}
.sheet-grip {
  width: 72rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--line);
  margin: 4rpx auto 16rpx;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sheet-title {
  font-size: 33rpx;
  font-weight: 900;
  color: var(--ink);
}
.sheet-x {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--field-bg);
  color: var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}
.rs-label {
  margin: 14rpx 0 18rpx;
}
.rs-dates {
  margin-bottom: 4rpx;
}

.rs-readout {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 26rpx 8rpx 4rpx;
}
.rs-readout text {
  font-size: 24rpx;
  font-weight: 700;
}
.rs-start,
.rs-end {
  color: var(--brand-deep);
}
.rs-dur {
  color: var(--muted);
}

.rs-track {
  position: relative;
  height: 120rpx;
  margin: 18rpx 14rpx 4rpx;
}
.rs-track::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 53rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #edf4f9;
}
.rs-fill {
  position: absolute;
  top: 53rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--brand), #6fd0ff);
}
.rs-tick {
  position: absolute;
  top: 47rpx;
  width: 2rpx;
  height: 26rpx;
  background: #d7e4ee;
  transform: translateX(-50%);
}
.rs-tag {
  position: absolute;
  top: 2rpx;
  transform: translateX(-50%);
  font-size: 22rpx;
  font-weight: 800;
  color: var(--brand-deep);
  white-space: nowrap;
}
.rs-handle {
  position: absolute;
  top: 37rpx;
  width: 46rpx;
  height: 46rpx;
  margin-left: -23rpx;
  border-radius: 50%;
  background: #fff;
  border: 4rpx solid var(--brand);
  box-shadow: var(--shadow-glow);
}
.rs-scale {
  display: flex;
  justify-content: space-between;
  margin: 0 14rpx;
  font-size: 18rpx;
  color: var(--muted);
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.sheet-actions .btn-ghost,
.sheet-actions .btn-black {
  flex: 1;
}

/* ============ 活动配图（上传缩略图网格） ============ */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.img-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--field-bg);
}
.img-thumb {
  width: 100%;
  height: 100%;
  display: block;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}
.img-cover {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
}
.img-rm {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(23, 26, 29, 0.55);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}
.img-add {
  width: 200rpx;
  height: 200rpx;
  border: 3rpx dashed var(--line);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: var(--muted);
}
.img-plus {
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
}
.img-add-tip {
  font-size: 22rpx;
}

/* ============ 加载/错误态 ============ */
.empty {
  margin-top: 120rpx;
  text-align: center;
}
.empty .icon {
  font-size: 80rpx;
}
.empty .title {
  font-size: 28rpx;
  color: var(--muted);
  margin: 20rpx 0 30rpx;
}
.retry {
  display: inline-block;
  padding: 18rpx 48rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #fff;
  font-weight: 700;
}
