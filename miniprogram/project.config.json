{
  "description": "meetbuddy 微信小程序端：同城活动组局与搭子匹配",
  "packOptions": {
    "ignore": [
      { "type": "file", "value": ".eslintrc.js" }
    ]
  },
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "compileType": "miniprogram",
  "libVersion": "3.4.10",
  "appid": "touristappid",
  "projectname": "meetbuddy-miniprogram",
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}
